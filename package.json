{
  "name": "celebi",
  "displayName": "Celebi",
  "publisher": "mzhao",
  "version": "0.0.1",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ."
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tslib": "^2.6.2",
    "typescript": "^5.1.6"
  },
  "contributes": {
    "configuration": {
      "title": "Repository",
      "properties": {
        "celebi.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python interpreter. If empty, auto-detects from virtualenv or uses 'python'"
        },
        "celebi.virtualenvPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python virtualenv directory (e.g., /path/to/.venv). Auto-detected if empty"
        },
        "celebi.packagePath": {
          "type": "string",
          "default": "",
          "description": "Optional: Path to CelebiChrono package (if not in Python path)"
        },
        "celebi.projectPath": {
          "type": "string",
          "default": "",
          "description": "Optional: Default Celebi project path"
        },
        "celebi.servers": {
          "type": "object",
          "default": {},
          "description": "Named server profiles for quick switching between local and remote CelebiChrono instances.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "description": "SSH host (e.g., user@hostname). If set, commands run remotely."
              },
              "pythonPath": {
                "type": "string",
                "description": "Path to Python interpreter on this server."
              },
              "virtualenvPath": {
                "type": "string",
                "description": "Path to virtualenv on this server."
              },
              "packagePath": {
                "type": "string",
                "description": "Path to CelebiChrono package on this server."
              }
            }
          }
        },
        "celebi.activeServer": {
          "type": "string",
          "default": "",
          "description": "Name of the currently active server profile (from celebi.servers). Set by the Switch Server command."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "celebiViewContainer",
          "title": "Celebi",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "celebiViewContainer": [
        {
          "id": "diteMessagePanel",
          "name": "Information",
          "icon": "media/icon.png",
          "type": "webview"
        },
        {
          "id": "celebiTreeView",
          "name": "Celebi",
          "icon": "media/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "celebi.runPythonPackage",
        "title": "Run Celebi Python Command",
        "icon": "$(play)"
      },
      {
        "command": "celebi.runInTerminal",
        "title": "Run Celebi Command in Terminal"
      },
      {
        "command": "celebi.showOutput",
        "title": "Show Celebi Output"
      },
      {
        "command": "celebi.refreshTree",
        "title": "Refresh Celebi Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "celebi.refreshDite",
        "title": "Refresh DITE Status",
        "icon": "$(refresh)"
      },
      {
        "command": "celebi.openObject",
        "title": "Open Celebi Object"
      },
      {
        "command": "celebi.submit",
        "title": "Submit Task",
        "icon": "$(run)"
      },
      {
        "command": "celebi.impress",
        "title": "Impress Object",
        "icon": "$(tag)"
      },
      {
        "command": "celebi.switchProject",
        "title": "Switch Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "celebi.execute",
        "title": "Execute Shell Command",
        "icon": "$(terminal)"
      },
      {
        "command": "celebi.switchServer",
        "title": "Switch Server",
        "icon": "$(server)"
      },
      {
        "command": "celebi.showTrace",
        "title": "Show Trace Visualization",
        "icon": "$(graph)"
      },
      {
        "command": "celebi.gitStatus",
        "title": "Git Status",
        "icon": "$(git-branch)"
      },
      {
        "command": "celebi.gitHistory",
        "title": "Git History",
        "icon": "$(history)"
      },
      {
        "command": "celebi.viewResults",
        "title": "View Results",
        "icon": "$(output)"
      },
      {
        "command": "celebi.showLs",
        "title": "List Directory Contents (LS)",
        "icon": "$(list-unordered)"
      },
      {
        "command": "celebi.showReadme",
        "title": "Show README",
        "icon": "$(book)"
      },
      {
        "command": "celebi.createTask",
        "title": "Create New Task",
        "icon": "$(play-circle)"
      },
      {
        "command": "celebi.createAlgorithm",
        "title": "Create New Algorithm",
        "icon": "$(symbol-method)"
      },
      {
        "command": "celebi.createDirectory",
        "title": "Create New Directory",
        "icon": "$(new-folder)"
      },
      {
        "command": "celebi.removeObject",
        "title": "Remove Object",
        "icon": "$(trash)"
      },
      {
        "command": "celebi.showStatus",
        "title": "Status",
        "icon": "$(pulse)"
      },
      {
        "command": "celebi.showTree",
        "title": "Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "celebi.showJobs",
        "title": "Jobs",
        "icon": "$(server)"
      },
      {
        "command": "celebi.objectStatus",
        "title": "Status",
        "icon": "$(pulse)"
      },
      {
        "command": "celebi.objectTree",
        "title": "Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "celebi.objectJobs",
        "title": "Jobs",
        "icon": "$(server)"
      },
      {
        "command": "celebi.objectChanges",
        "title": "Changes",
        "icon": "$(diff)"
      },
      {
        "command": "celebi.objectHistory",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "celebi.objectSubmit",
        "title": "Submit",
        "icon": "$(run)"
      },
      {
        "command": "celebi.objectJob",
        "title": "Job",
        "icon": "$(server)"
      },
      {
        "command": "celebi.objectResubmit",
        "title": "Resubmit",
        "icon": "$(debug-restart)"
      },
      {
        "command": "celebi.objectResults",
        "title": "Results",
        "icon": "$(output)"
      },
      {
        "command": "celebi.objectImpress",
        "title": "Impress",
        "icon": "$(tag)"
      },
      {
        "command": "celebi.objectPre",
        "title": "Pre",
        "icon": "$(arrow-left)"
      },
      {
        "command": "celebi.objectSuc",
        "title": "Suc",
        "icon": "$(arrow-right)"
      },
      {
        "command": "celebi.objectCat",
        "title": "Cat",
        "icon": "$(file-text)"
      },
      {
        "command": "celebi.clearMessages",
        "title": "Clear DITE Messages",
        "icon": "$(trash)"
      },
      {
        "command": "celebi.showDiteMessages",
        "title": "Show DITE Messages"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "celebi.refreshTree",
          "when": "view == celebiTreeView",
          "group": "navigation"
        },
        {
          "command": "celebi.showTrace",
          "when": "view == celebiTreeView",
          "group": "navigation"
        },
        {
          "command": "celebi.clearMessages",
          "when": "view == diteMessagePanel",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "celebi.refreshDite",
          "when": "false"
        },
        {
          "command": "celebi.createTask",
          "when": "false"
        },
        {
          "command": "celebi.createAlgorithm",
          "when": "false"
        },
        {
          "command": "celebi.createDirectory",
          "when": "false"
        },
        {
          "command": "celebi.removeObject",
          "when": "false"
        },
        {
          "command": "celebi.showStatus",
          "when": "false"
        },
        {
          "command": "celebi.showTree",
          "when": "false"
        },
        {
          "command": "celebi.showJobs",
          "when": "false"
        },
        {
          "command": "celebi.objectStatus",
          "when": "false"
        },
        {
          "command": "celebi.objectTree",
          "when": "false"
        },
        {
          "command": "celebi.objectJobs",
          "when": "false"
        },
        {
          "command": "celebi.objectChanges",
          "when": "false"
        },
        {
          "command": "celebi.objectHistory",
          "when": "false"
        },
        {
          "command": "celebi.objectSubmit",
          "when": "false"
        },
        {
          "command": "celebi.objectJob",
          "when": "false"
        },
        {
          "command": "celebi.objectResubmit",
          "when": "false"
        },
        {
          "command": "celebi.objectResults",
          "when": "false"
        },
        {
          "command": "celebi.objectImpress",
          "when": "false"
        },
        {
          "command": "celebi.objectPre",
          "when": "false"
        },
        {
          "command": "celebi.objectSuc",
          "when": "false"
        },
        {
          "command": "celebi.objectCat",
          "when": "false"
        },
        {
          "command": "celebi.clearMessages",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "celebi.runPythonPackage",
          "when": "view == celebiTreeView && viewItem == task",
          "group": "inline"
        },
        {
          "command": "celebi.showStatus",
          "when": "view == celebiTreeView && viewItem == view-group",
          "group": "inline@1"
        },
        {
          "command": "celebi.showTree",
          "when": "view == celebiTreeView && viewItem == view-group",
          "group": "inline@2"
        },
        {
          "command": "celebi.showLs",
          "when": "view == celebiTreeView && viewItem == view-group",
          "group": "inline@3"
        },
        {
          "command": "celebi.showJobs",
          "when": "view == celebiTreeView && viewItem == view-group",
          "group": "inline@4"
        },
        {
          "command": "celebi.objectStatus",
          "when": "view == celebiTreeView && viewItem == object-view-group",
          "group": "inline@1"
        },
        {
          "command": "celebi.objectTree",
          "when": "view == celebiTreeView && viewItem == object-view-group",
          "group": "inline@2"
        },
        {
          "command": "celebi.showLs",
          "when": "view == celebiTreeView && viewItem == object-view-group",
          "group": "inline@3"
        },
        {
          "command": "celebi.objectJobs",
          "when": "view == celebiTreeView && viewItem == object-view-group",
          "group": "inline@4"
        },
        {
          "command": "celebi.viewResults",
          "when": "view == celebiTreeView && viewItem == object-view-group",
          "group": "inline@5"
        },
        {
          "command": "celebi.submit",
          "when": "view == celebiTreeView && viewItem == actions-group",
          "group": "inline@1"
        },
        {
          "command": "celebi.impress",
          "when": "view == celebiTreeView && viewItem == actions-group",
          "group": "inline@2"
        },
        {
          "command": "celebi.switchProject",
          "when": "view == celebiTreeView && viewItem == actions-group",
          "group": "inline@3"
        },
        {
          "command": "celebi.execute",
          "when": "view == celebiTreeView && viewItem == actions-group",
          "group": "inline@4"
        },
        {
          "command": "celebi.showTrace",
          "when": "view == celebiTreeView && viewItem == git-group",
          "group": "inline@1"
        },
        {
          "command": "celebi.gitStatus",
          "when": "view == celebiTreeView && viewItem == git-group",
          "group": "inline@2"
        },
        {
          "command": "celebi.gitHistory",
          "when": "view == celebiTreeView && viewItem == git-group",
          "group": "inline@3"
        },
        {
          "command": "celebi.createTask",
          "when": "view == celebiTreeView && (viewItem == project || viewItem == directory)",
          "group": "inline@1"
        },
        {
          "command": "celebi.createAlgorithm",
          "when": "view == celebiTreeView && (viewItem == project || viewItem == directory)",
          "group": "inline@2"
        },
        {
          "command": "celebi.createDirectory",
          "when": "view == celebiTreeView && (viewItem == project || viewItem == directory)",
          "group": "inline@3"
        },
        {
          "command": "celebi.removeObject",
          "when": "view == celebiTreeView && (viewItem == project || viewItem == directory || viewItem == task || viewItem == algorithm || viewItem == data)",
          "group": "inline@9"
        },
        {
          "command": "celebi.objectStatus",
          "when": "view == celebiTreeView && viewItem == info-group",
          "group": "inline@1"
        },
        {
          "command": "celebi.showLs",
          "when": "view == celebiTreeView && viewItem == info-group",
          "group": "inline@2"
        },
        {
          "command": "celebi.objectChanges",
          "when": "view == celebiTreeView && viewItem == info-group",
          "group": "inline@3"
        },
        {
          "command": "celebi.objectHistory",
          "when": "view == celebiTreeView && viewItem == info-group",
          "group": "inline@4"
        },
        {
          "command": "celebi.objectSubmit",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@1"
        },
        {
          "command": "celebi.objectJob",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@2"
        },
        {
          "command": "celebi.objectResubmit",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@3"
        },
        {
          "command": "celebi.objectResults",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@4"
        },
        {
          "command": "celebi.objectImpress",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@5"
        },
        {
          "command": "celebi.objectPre",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@6"
        },
        {
          "command": "celebi.objectSuc",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@7"
        },
        {
          "command": "celebi.objectCat",
          "when": "view == celebiTreeView && viewItem == exec-group",
          "group": "inline@8"
        },
        {
          "command": "celebi.submit",
          "when": "view == celebiTreeView",
          "group": "1_action@1"
        },
        {
          "command": "celebi.impress",
          "when": "view == celebiTreeView && viewItem == algorithm",
          "group": "1_action@2"
        },
        {
          "command": "celebi.showTrace",
          "when": "view == celebiTreeView",
          "group": "2_visualization@1"
        },
        {
          "command": "celebi.gitStatus",
          "when": "view == celebiTreeView",
          "group": "3_git@1"
        },
        {
          "command": "celebi.gitHistory",
          "when": "view == celebiTreeView",
          "group": "3_git@2"
        }
      ]
    }
  }
}

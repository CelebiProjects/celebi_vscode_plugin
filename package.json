{
  "name": "celebi",
  "displayName": "Celebi",
  "publisher": "celebi",
  "version": "0.0.5",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:celebiTreeView"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/CelebiProjects/celebi_vscode_plugin.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:package": "node scripts/build-package.js",
    "compile": "npm run build:package && tsc -p .",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "jest": "^30.3.0",
    "jsroot": "^7.11.0",
    "ts-jest": "^29.4.9",
    "tslib": "^2.6.2",
    "typescript": "^5.1.6",
    "pdfjs-dist": "^6.3.289"
  },
  "contributes": {
    "configuration": {
      "title": "Repository",
      "properties": {
        "celebi.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python interpreter. If empty, auto-detects from virtualenv or uses 'python3'"
        },
        "celebi.virtualenvPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python virtualenv directory (e.g., /path/to/.venv). Auto-detected if empty"
        },
        "celebi.packagePath": {
          "type": "string",
          "default": "",
          "description": "Optional: Path to CelebiChrono package (if not in Python path)"
        },
        "celebi.diteServerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3315",
          "description": "DITE server URL used when the project has no .celebi/hosts.json"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "celebiViewContainer",
          "title": "Celebi",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "celebiViewContainer": [
        {
          "id": "celebiTreeView",
          "name": "Celebi",
          "icon": "media/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "celebi.refreshTree",
        "title": "Refresh Celebi Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "celebi.copyPath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "celebi.copyRelativePath",
        "title": "Copy Relative Path",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "celebi.refreshTree",
          "when": "view == celebiTreeView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "celebi.copyPath",
          "when": "view == celebiTreeView && viewItem =~ /^(object|directory|file)$/",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "celebi.copyRelativePath",
          "when": "view == celebiTreeView && viewItem =~ /^(object|directory|file)$/",
          "group": "9_cutcopypaste@2"
        }
      ]
    }
  }
}
